<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Examifo_Desktop.Pages.ExamListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Available Exams"
    BackgroundColor="#F6F8FB">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              Padding="20,16">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                    <GradientStop
                        Color="#202A72"
                        Offset="0" />

                    <GradientStop
                        Color="#4B3FE4"
                        Offset="1" />

                </LinearGradientBrush>
            </Grid.Background>

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

            <VerticalStackLayout Grid.Column="0" Spacing="2">

                <Label
                    Text="Examifo"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Available examinations"
                    FontSize="13"
                    TextColor="#DDE3FF" />

            </VerticalStackLayout>

            <Button Grid.Column="1" Text="Logout" Clicked="LogoutButton_Clicked"
                    BackgroundColor="#FFFFFF22" TextColor="White" CornerRadius="8" />

            </Grid>

        </Grid>

        <Grid
            Grid.Row="1"
            Padding="20"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="15">

            <Label
                Text="Available Exams"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Grid.Row="1"
                Text="Select an examination to continue."
                FontSize="14"
                TextColor="#64748B" />

            <RefreshView x:Name="ExamRefreshView"
                         Grid.Row="2"
                         Refreshing="RefreshView_Refreshing">
              <CollectionView
                  x:Name="ExamCollectionView"
                  SelectionMode="Single"
                  Margin="0,10,0,0">

                <CollectionView.EmptyView>
                    <Label Text="No exams are currently available."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="#64748B" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            BackgroundColor="White"
                            BorderColor="#E5E7EB"
                            CornerRadius="14"
                            HasShadow="True"
                            Padding="18"
                            Margin="0,6">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="10">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="WidthStates">
                                        <VisualState Name="Compact">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter TargetName="AvailabilityBadge" Property="Grid.Row" Value="1" />
                                                <Setter TargetName="AvailabilityBadge" Property="Grid.Column" Value="0" />
                                                <Setter TargetName="ExamDescription" Property="Grid.Row" Value="2" />
                                                <Setter TargetName="ExamDuration" Property="Grid.Row" Value="3" />
                                                <Setter TargetName="OfflineStatus" Property="Grid.Row" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Wide">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="620" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter TargetName="AvailabilityBadge" Property="Grid.Row" Value="0" />
                                                <Setter TargetName="AvailabilityBadge" Property="Grid.Column" Value="1" />
                                                <Setter TargetName="ExamDescription" Property="Grid.Row" Value="1" />
                                                <Setter TargetName="ExamDuration" Property="Grid.Row" Value="2" />
                                                <Setter TargetName="OfflineStatus" Property="Grid.Row" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Title}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                                <Frame
                                    x:Name="AvailabilityBadge"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="#E0F2FE"
                                    BorderColor="#BAE6FD"
                                    CornerRadius="12"
                                    Padding="9,4"
                                    HasShadow="False"
                                    VerticalOptions="Start">

                                    <Label
                                        Text="ASSIGNED"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#1479F5" />

                                </Frame>

                                <Label
                                    x:Name="ExamDescription"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Description}"
                                    FontSize="14"
                                    TextColor="#64748B" />

                                <Label
                                    x:Name="ExamDuration"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DurationMinutes, StringFormat='Duration: {0} minutes'}"
                                    FontSize="13"
                                    TextColor="#08A6B5" />

                                <Label
                                    x:Name="OfflineStatus"
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding OfflineStatus}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding OfflineStatusColor}" />

                            </Grid>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

              </CollectionView>
            </RefreshView>

        </Grid>

        <Frame x:Name="OfflineToast"
               Grid.RowSpan="2"
               IsVisible="False"
               Opacity="0"
               ZIndex="20"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="20,112,20,0"
               Padding="16,10"
               CornerRadius="12"
               HasShadow="True"
               BackgroundColor="#123B2A"
               BorderColor="#34D399">
            <Label x:Name="OfflineToastLabel"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="13" />
        </Frame>

    </Grid>

</ContentPage>
